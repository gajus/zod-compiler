{
  "name": "zod-compiler",
  "version": "1.0.18",
  "description": "Compile Zod schemas into zero-overhead validation functions",
  "keywords": [
    "aot",
    "codegen",
    "compiler",
    "performance",
    "schema",
    "typescript",
    "validation",
    "zod"
  ],
  "license": "BSD-3-Clause",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gajus/zod-compiler.git"
  },
  "bin": {
    "zod-compiler": "./dist/cli/index.js"
  },
  "files": [
    "dist",
    "schema.json",
    "LICENSE"
  ],
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "source": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./jit": {
      "types": "./dist/jit.d.ts",
      "source": "./src/jit.ts",
      "import": "./dist/jit.js",
      "default": "./dist/jit.js"
    },
    "./register": {
      "types": "./dist/register/index.d.ts",
      "source": "./src/register/index.ts",
      "import": "./dist/register/index.js",
      "default": "./dist/register/index.js"
    },
    "./schema.json": "./schema.json",
    "./vite": {
      "types": "./dist/unplugin/vite.d.ts",
      "source": "./src/unplugin/vite.ts",
      "import": "./dist/unplugin/vite.js",
      "default": "./dist/unplugin/vite.js"
    },
    "./webpack": {
      "types": "./dist/unplugin/webpack.d.ts",
      "source": "./src/unplugin/webpack.ts",
      "import": "./dist/unplugin/webpack.js",
      "default": "./dist/unplugin/webpack.js"
    },
    "./esbuild": {
      "types": "./dist/unplugin/esbuild.d.ts",
      "source": "./src/unplugin/esbuild.ts",
      "import": "./dist/unplugin/esbuild.js",
      "default": "./dist/unplugin/esbuild.js"
    },
    "./rollup": {
      "types": "./dist/unplugin/rollup.d.ts",
      "source": "./src/unplugin/rollup.ts",
      "import": "./dist/unplugin/rollup.js",
      "default": "./dist/unplugin/rollup.js"
    },
    "./rolldown": {
      "types": "./dist/unplugin/rolldown.d.ts",
      "source": "./src/unplugin/rolldown.ts",
      "import": "./dist/unplugin/rolldown.js",
      "default": "./dist/unplugin/rolldown.js"
    },
    "./bun": {
      "types": "./dist/unplugin/bun.d.ts",
      "source": "./src/unplugin/bun.ts",
      "import": "./dist/unplugin/bun.js",
      "default": "./dist/unplugin/bun.js"
    },
    "./rspack": {
      "types": "./dist/unplugin/rspack.d.ts",
      "source": "./src/unplugin/rspack.ts",
      "import": "./dist/unplugin/rspack.js",
      "default": "./dist/unplugin/rspack.js"
    },
    "./rsbuild": {
      "types": "./dist/unplugin/rsbuild.d.ts",
      "source": "./src/unplugin/rsbuild.ts",
      "import": "./dist/unplugin/rsbuild.js",
      "default": "./dist/unplugin/rsbuild.js"
    },
    "./farm": {
      "types": "./dist/unplugin/farm.d.ts",
      "source": "./src/unplugin/farm.ts",
      "import": "./dist/unplugin/farm.js",
      "default": "./dist/unplugin/farm.js"
    },
    "./swc": {
      "types": "./dist/swc.d.ts",
      "source": "./src/swc.ts",
      "import": "./dist/swc.js",
      "default": "./dist/swc.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "import": "./dist/runtime.js",
      "default": "./dist/runtime.js"
    },
    "./turbopack": {
      "types": "./dist/turbopack.d.ts",
      "source": "./src/turbopack.ts",
      "import": "./dist/turbopack.js",
      "default": "./dist/turbopack.js"
    }
  },
  "scripts": {
    "benchmark": "vp pack && vp test bench --config benchmarks/vite.config.ts",
    "build": "vp pack",
    "dev": "vp pack --watch",
    "lint": "vp check && vp exec knip",
    "size:cli": "vp run --filter @zod-compiler/benchmarks size:cli",
    "size:unplugin": "vp run --filter @zod-compiler/benchmarks size:unplugin",
    "startup:unplugin": "vp pack && vp run --filter @zod-compiler/benchmarks startup:unplugin",
    "test": "vp test run",
    "prepare": "vp config"
  },
  "dependencies": {
    "@jridgewell/remapping": "^2.3.5",
    "acorn": "^8.16.0",
    "es-module-lexer": "^2.3.1",
    "get-tsconfig": "^4.14.0",
    "jiti": "^2.7.0",
    "magic-string": "^0.30.21",
    "picomatch": "^4.0.4",
    "unplugin": "^3.0.0"
  },
  "devDependencies": {
    "@jridgewell/trace-mapping": "^0.3.31",
    "@rsbuild/core": "^2.1.7",
    "@swc/core": "^1.15.43",
    "@types/node": "catalog:",
    "@types/picomatch": "^4.0.3",
    "@vitest/coverage-v8": "catalog:",
    "knip": "^6.29.0",
    "publint": "^0.3.22",
    "semantic-release": "^25.0.3",
    "ts-json-schema-generator": "^2.9.0",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:",
    "zod": "catalog:"
  },
  "peerDependencies": {
    "@rsbuild/core": "^1.0.0 || ^2.0.0",
    "@swc/core": ">=1.3.0",
    "zod": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "@rsbuild/core": {
      "optional": true
    },
    "@swc/core": {
      "optional": true
    }
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.18.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@10.33.1"
}
